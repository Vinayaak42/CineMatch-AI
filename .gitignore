.DS_Store
Thumbs.db

# User data and databases
data/cinematch.db
data/cinematch.db-shm
data/cinematch.db-wal

# Generated model and experiment artifacts
mlruns/
mlartifacts/

# Editor files
.vscode/
.idea/
